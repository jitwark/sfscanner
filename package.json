{
  "name": "n8n-secureflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "contracts",
    "app",
    "pipeline",
    "packages/scanner-core",
    "packages/scanner-cli"
  ],
  "scripts": {
    "dev": "npm run dev --workspace app",
    "build": "npm run build:scanner && node scripts/sync-data.mjs && node scripts/validate-corpus-integrity.mjs data && node scripts/generate-favicon.mjs && node scripts/generate-og-images.mjs && npm run build --workspace app && npm run build:lean-pages && node scripts/generate-sitemaps.mjs && node scripts/prune-export-catalogue-shards.mjs && node scripts/prune-export-preview-artifacts.mjs && node scripts/prune-export-scanner-sidecars.mjs app/out && node scripts/check-page-parity.mjs && node scripts/check-export-budget.mjs && node scripts/check-bundle-budget.mjs && node scripts/measure-budgets.mjs && node scripts/compare-budgets.mjs && node app/qa/check-seo.mjs && node scripts/check-generated-assets.mjs",
    "build:scanner": "npm run build --workspace sfscanner",
    "typecheck": "npm run typecheck --workspace contracts && npm run typecheck --workspace app && npm run typecheck --workspace pipeline && npm run typecheck --workspace @hub/scanner-core && npm run typecheck --workspace sfscanner && npm run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "pretest": "node scripts/sync-data.mjs --if-present",
    "test": "vitest run",
    "test:source": "vitest run --project scanner-core --project scanner-cli --project contracts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "measure:search-runtime": "node scripts/measure-search-runtime.mjs",
    "measure:scanner-baseline": "node --import tsx scripts/measure-scanner-baseline.mjs",
    "measure:scanner-v2": "node --import tsx scripts/measure-scanner-v2.mjs",
    "check:scanner-v2-budget": "node --import tsx scripts/compare-scanner-v2-budget.mjs",
    "check:scanner-v2-budget:cross-machine": "node --import tsx scripts/compare-scanner-v2-budget.mjs --adr docs/decisions/scanner-v2-performance-budget.md --reason \"Cross-machine CI is not comparable for p95; this named policy retains byte and max-bound checks.\"",
    "lint": "npm run lint --workspace app && npm run lint --workspace contracts && npm run lint --workspace pipeline && npm run lint --workspace @hub/scanner-core && npm run lint --workspace sfscanner && eslint scripts",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:audit": "node scripts/audit-with-waivers.mjs",
    "check:file-size:all": "node scripts/check-file-size.mjs --all",
    "check:specs": "node scripts/check-specs.mjs",
    "check:scanner-evidence": "node --import tsx scripts/check-scanner-evidence.mjs",
    "check:browser-safe": "node pipeline/check-browser-safe.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:accent-usage": "node scripts/check-accent-usage.mjs",
    "check:browser-safe:emitted": "node pipeline/check-browser-safe.mjs --emitted",
    "check:import-boundary": "node scripts/check-import-boundary.mjs",
    "check:scanner-import-boundary": "node scripts/check-scanner-import-boundary.mjs",
    "check:regex-safety": "node scripts/check-regex-safety.mjs",
    "check:export": "node scripts/check-export-budget.mjs",
    "check:export-spot-check": "node scripts/check-export-spot-check.mjs",
    "check:corpus": "node scripts/validate-corpus-integrity.mjs",
    "check:rights-invariant": "node scripts/check-rights-invariant.mjs",
    "check:corpus-privacy": "node scripts/check-corpus-privacy.mjs",
    "check:published-secret-leak": "node scripts/check-published-secret-leak.mjs",
    "check:release": "node scripts/validate-corpus-integrity.mjs --release",
    "check:data-sync": "node scripts/check-data-sync.mjs",
    "check:search-governance": "node scripts/check-search-governance.mjs",
    "check:cli-schemas": "node scripts/check-cli-schema-files.mjs",
    "check:scanner-advisories": "node scripts/check-scanner-advisories.mjs data/scanner/advisories-v2.json data/scanner/advisory-quarantine-v1.json",
    "check:scanner-calibration": "node --import tsx scripts/check-scanner-calibration.mjs",
    "check:scanner-parity": "node --import tsx scripts/check-scanner-parity.mjs",
    "check:scanner-v2-parity": "node --import tsx scripts/check-scanner-v2-parity.mjs",
    "check:scanner-authority": "node scripts/check-scanner-authority.mjs",
    "check:scanner-goldens": "node --import tsx scripts/check-scanner-goldens.mjs",
    "check:scanner-mutation": "node scripts/run-scanner-mutation-gate.mjs",
    "check:search-quality": "node scripts/check-search-quality.mjs",
    "check:legal-identity": "node scripts/check-legal-identity.mjs",
    "check:catalogue-claim-freshness": "node scripts/check-catalogue-claim-freshness.mjs",
    "rollback:release": "node scripts/rollback-release.mjs",
    "stage:release": "node scripts/stage-release.mjs --mode release",
    "rehearse:release-rollback": "node scripts/rehearse-release-rollback.mjs",
    "prepare:release-data": "node scripts/prepare-release-data.mjs",
    "migrate:scanner-result-schema": "node --import tsx scripts/migrate-scanner-result-schema.mjs",
    "check:docs": "node scripts/check-doc-consistency.mjs",
    "check:generated-assets": "node scripts/check-generated-assets.mjs",
    "check:cli-docs": "node scripts/check-cli-docs.mjs",
    "generate:scanner-reference": "node scripts/generate-scanner-reference.mjs",
    "generate:scanner-sbom": "node scripts/generate-scanner-sbom.mjs",
    "check:scanner-reproducibility": "node scripts/check-scanner-reproducibility.mjs",
    "generate:diagnostic-registry": "node scripts/generate-diagnostic-registry.mjs",
    "check:scanner-v2-docs": "node scripts/check-scanner-v2-docs.mjs",
    "check:diagnostic-registry": "node scripts/generate-diagnostic-registry.mjs --check",
    "check:scanner-source-claims": "node scripts/check-scanner-source-claims.mjs",
    "check:scanner-doc-claims": "node scripts/check-scanner-doc-claims.mjs",
    "check:attribution-basis": "node scripts/check-attribution-basis.mjs",
    "check:attributions": "tsx pipeline/generate-attributions.ts --check",
    "check:scanner-evidence-freshness": "node scripts/check-scanner-evidence-freshness.mjs",
    "check:scanner-docs": "node scripts/check-scanner-doc-consistency.mjs",
    "check:budgets": "node scripts/measure-budgets.mjs && node scripts/compare-budgets.mjs",
    "audit:client-boundaries": "node scripts/audit-client-boundaries.mjs --write docs/audit/2026-08-30/LOCAL-WAVE-27-PERF.md",
    "audit:generated-assets": "node scripts/check-generated-assets.mjs",
    "audit:gemini-input": "node scripts/audit-gemini-input.mjs",
    "repair:model-workflows": "tsx scripts/repair-model-workflows.ts",
    "repair:connection-counts": "tsx scripts/repair-connection-counts.ts",
    "report:enrichment-batch": "node scripts/report-enrichment-batch.mjs",
    "corpus": "tsx pipeline/build-corpus.ts",
    "maintenance:plan": "node scripts/maintenance.mjs plan",
    "maintenance:candidate": "node scripts/maintenance.mjs candidate",
    "export:public-dataset": "node --import tsx scripts/export-public-dataset.ts",
    "gates": "node scripts/run-gates.mjs gates",
    "gates:source": "node scripts/run-gates.mjs source",
    "release:gates": "node scripts/run-gates.mjs release",
    "sync:data": "node scripts/sync-data.mjs",
    "backfill:previews": "tsx scripts/backfill-preview-artifacts.ts",
    "deploy:firebase-preview": "node scripts/deploy-firebase-preview.mjs",
    "attributions": "tsx pipeline/generate-attributions.ts",
    "scan:cli": "tsx pipeline/cli/n8n-scan.ts",
    "evaluate:search-ranking": "node --import tsx scripts/search-ranking/run-improvement.ts",
    "build:lean-pages": "node --max-old-space-size=8192 node_modules/tsx/dist/cli.mjs scripts/generate-lean-pages.tsx",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node app/qa/check-seo.mjs",
    "check:web-release": "node scripts/check-web-release-parity.mjs --dataset-dir outputs/public-dataset",
    "check:parity": "node scripts/check-page-parity.mjs",
    "check:graph": "node --max-old-space-size=6144 scripts/check-graph-coherence.mjs",
    "check:codebase-memory-cache": "node scripts/check-codebase-memory-cache.mjs",
    "check:scanner-core:bare-node": "node --import tsx scripts/check-scanner-core-bare-node.mjs",
    "verify:release": "node scripts/release-verify.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "next": "16.4.3",
    "typescript": "^5.7.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      ".": "11.0.1",
      "brace-expansion": "5.0.12"
    }
  }
}
