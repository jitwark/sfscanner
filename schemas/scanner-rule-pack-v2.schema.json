{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scanner-rule-pack-v2.schema.json",
  "title": "SecureFlow Scanner Rule Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "compatibleEngine",
    "requiredSafeFactRegistryDigest",
    "rules",
    "signatures"
  ],
  "properties": {
    "schemaVersion": { "const": "scanner-rule-pack-v2" },
    "id": { "$ref": "#/$defs/text" },
    "version": { "$ref": "#/$defs/semver" },
    "compatibleEngine": { "$ref": "#/$defs/versionRange" },
    "requiredSafeFactRegistryDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/rule" }
    },
    "signatures": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/signature" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!//)"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "versionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clauses"],
      "properties": {
        "clauses": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": { "$ref": "#/$defs/comparator" }
          }
        }
      }
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "version"],
      "properties": {
        "op": { "enum": ["EQ", "LT", "LTE", "GT", "GTE"] },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "revision", "capabilityId", "evidenceSchemaId", "remediationId", "when"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/text" },
        "revision": { "$ref": "#/$defs/text" },
        "capabilityId": { "$ref": "#/$defs/text" },
        "evidenceSchemaId": { "$ref": "#/$defs/text" },
        "remediationId": { "$ref": "#/$defs/text" },
        "when": { "$ref": "#/$defs/expression" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": { "$ref": "#/$defs/text" },
        "algorithm": { "const": "Ed25519" },
        "signature": { "$ref": "#/$defs/text" }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "kind"],
          "properties": {
            "op": { "const": "FACT_EXISTS" },
            "kind": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "factKind", "property", "value"],
          "properties": {
            "op": { "const": "PROPERTY_EQ" },
            "factKind": { "$ref": "#/$defs/text" },
            "property": { "$ref": "#/$defs/text" },
            "value": { "type": ["string", "number", "boolean", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "factKind", "property", "values"],
          "properties": {
            "op": { "const": "PROPERTY_IN" },
            "factKind": { "$ref": "#/$defs/text" },
            "property": { "$ref": "#/$defs/text" },
            "values": {
              "type": "array",
              "maxItems": 1000,
              "items": { "type": ["string", "number", "boolean", "null"] }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "expressions"],
          "properties": {
            "op": { "const": "ALL" },
            "expressions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "expressions"],
          "properties": {
            "op": { "const": "ANY" },
            "expressions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "expression"],
          "properties": {
            "op": { "const": "NOT" },
            "expression": { "$ref": "#/$defs/expression" }
          }
        }
      ],
      "x-maxDepth": 32,
      "x-maxNodes": 1000,
      "$comment": "The admission implementation enforces a maximum AST nesting depth of 32 and 1,000 expression nodes."
    },
    "triState": { "enum": ["TRUE", "FALSE", "UNKNOWN"] }
  }
}
