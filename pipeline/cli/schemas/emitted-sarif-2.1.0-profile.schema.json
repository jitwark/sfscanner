{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:n8n-secureflow:emitted-sarif-2.1.0-profile",
  "title": "n8n SecureFlow CLI emitted SARIF 2.1.0 profile",
  "description": "The narrow SARIF 2.1.0 profile emitted by the offline scanner CLI. This is not a complete external SARIF 2.1.0 conformance schema; use a full SARIF validator when a consumer requires that guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "runs"],
  "properties": {
    "$schema": {"const": "https://json.schemastore.org/sarif-2.1.0.json"},
    "version": {"const": "2.1.0"},
    "runs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "run": {
      "type": "object", "additionalProperties": false, "required": ["tool", "results", "invocations"],
      "properties": {"tool": {"$ref": "#/$defs/tool"}, "results": {"type": "array", "items": {"$ref": "#/$defs/result"}}, "invocations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/invocation"}}}
    },
    "tool": {"type": "object", "additionalProperties": false, "required": ["driver"], "properties": {"driver": {"$ref": "#/$defs/driver"}}},
    "driver": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "informationUri", "rules"],
      "properties": {
        "name": {"const": "n8n-scan"}, "version": {"const": "0.1.0"}, "informationUri": {"const": "https://github.com/jitwark/n8n-Secureflow"},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}, "uniqueItems": true}
      },
      "$comment": "The local validator additionally requires unique, canonically sorted rule IDs and declares every result ruleId."
    },
    "rule": {"type": "object", "additionalProperties": false, "required": ["id", "shortDescription"], "properties": {"id": {"$ref": "#/$defs/nonEmptyString"}, "shortDescription": {"$ref": "#/$defs/textMessage"}}},
    "result": {
      "type": "object", "additionalProperties": false, "required": ["ruleId", "level", "message"],
      "properties": {"ruleId": {"$ref": "#/$defs/nonEmptyString"}, "level": {"enum": ["error", "warning", "note"]}, "message": {"$ref": "#/$defs/textMessage"}, "locations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/location"}}},
      "$comment": "The local validator requires ruleId to be declared in runs[0].tool.driver.rules."
    },
    "textMessage": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"$ref": "#/$defs/nonEmptyString"}}},
    "location": {"type": "object", "additionalProperties": false, "required": ["physicalLocation"], "properties": {"physicalLocation": {"$ref": "#/$defs/physicalLocation"}}},
    "physicalLocation": {
      "type": "object", "additionalProperties": false, "required": ["artifactLocation", "region"],
      "properties": {"artifactLocation": {"type": "object", "additionalProperties": false, "required": ["uri"], "properties": {"uri": {"$ref": "#/$defs/nonEmptyString"}}}, "region": {"$ref": "#/$defs/region"}}
    },
    "region": {
      "type": "object", "additionalProperties": false, "required": ["startLine", "startColumn", "endLine", "endColumn", "charOffset", "charLength"],
      "properties": {"startLine": {"type": "integer", "minimum": 1}, "startColumn": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}, "endColumn": {"type": "integer", "minimum": 1}, "charOffset": {"type": "integer", "minimum": 0}, "charLength": {"type": "integer", "minimum": 0}},
      "$comment": "The local validator additionally rejects a region whose end precedes its start."
    },
    "invocation": {
      "type": "object", "additionalProperties": false, "required": ["executionSuccessful", "toolExecutionNotifications"],
      "properties": {"executionSuccessful": {"type": "boolean"}, "toolExecutionNotifications": {"type": "array", "items": {"$ref": "#/$defs/notification"}}},
      "allOf": [
        {
          "if": {"properties": {"executionSuccessful": {"const": true}}, "required": ["executionSuccessful"]},
          "then": {"properties": {"toolExecutionNotifications": {"maxItems": 0}}}
        }
      ]
    },
    "notification": {
      "type": "object", "additionalProperties": false, "required": ["descriptor", "message", "properties"],
      "properties": {
        "descriptor": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/nonEmptyString"}}},
        "message": {"$ref": "#/$defs/textMessage"},
        "properties": {"type": "object", "additionalProperties": false, "required": ["input", "kind", "code"], "properties": {"input": {"$ref": "#/$defs/nonEmptyString"}, "kind": {"enum": ["input", "internal", "cancelled"]}, "code": {"$ref": "#/$defs/nonEmptyString"}}}
      }
    }
  }
}
