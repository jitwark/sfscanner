node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Pipeline scratch: shallow clones, stage checkpoints, run artifacts.
pipeline/.work/

# Generated data is published from data/, not from the app's public tree.
app/public/data/

# Open Graph images and sitemaps are regenerated by `npm run build`, which writes
# app/public/og and app/out. Two stray trees also exist: app/app/public/ and this
# workspace's own public/, the latter holding sitemaps from a superseded generator
# (sitemap-core.xml, since replaced by sitemap-pages.xml). Only app/public/og and
# app/out are real. Deleting the strays and giving each script one resolved output
# directory is tracked in phase-6-hardening.md.
app/public/og/
app/app/public/
/public/

# Corpus run reports. Regenerated per run; the numbers that matter are promoted
# into STATUS.md.
pipeline/reports/

# Emitted declarations and typegen output. Both workspaces run with noEmit; these
# appear when a tool is invoked with declaration emit and must never be committed.
app/.types/
contracts/.types/
pipeline/**/*.d.ts

# Agent coordination packets.
.work/

# Private rollback copies produced by prepare-release-data in standalone candidates.
_backups/

# The production corpus in `data/` IS committed, and this is the commit where
# that started. The rule above it used to ignore `data/`, on the reasoning that
# interim artifacts from partial runs are not history — correct while runs were
# partial, and wrong the moment the full acquisition and enrichment run landed
# and the privacy audit passed.
#
# It had become a release blocker rather than hygiene: the deploy workflow checks
# out the repository and immediately runs check:docs, check:release, test and
# build, every one of which reads `data/`. With the directory ignored there was
# nothing on the runner to gate or to build, so CI could never have gone green.
#
# Interim runs are still excluded — they live in `pipeline/.work/`, which is
# ignored above.

# Playwright
app/test-results/
app/playwright-report/
.env.local
.env
.env.*
!.env.example
firebase.txt
.DS_Store

# Scratch run logs from local verification (serve output, e2e transcripts).
*.log
app/*.log

# Local QA and agent-tool scratch. Keep the evidence on disk when present, but
# never let a broad `git add` publish it with the source tree.
.playwright-mcp/
.testsprite/
testsprite-plans/
testsprite_tests/
outputs/
.superpowers/
.codex/
testsprite_tests/tmp/
testsprite_tests/tmp/config.json

# graft's local graph cache — regenerable, not committed (run `trail build`).
/graft/

# Per-packet scratch directories (each packet that used one has leaked into a commit at least once).
.*-scratch/

# Playwright failure artifacts. These are test output, never source: they were committed once, and a stale
# failure from a bug that has since been fixed would otherwise ship as if it were current.
test-results/

# Scanner execution artifacts (`.task-<id>-<n>.json`). Anchored to the workspace root so test fixtures
# under src/** stay tracked, and tarballs are ignored per directory rather than with a bare `*.tgz`.
.task*-*.json
/*.tgz
/outputs/distribution/*.tgz

# Authentic private workflow fixtures: unredistributable link-only bodies must not be committed.
pipeline/scan/__fixtures__/

